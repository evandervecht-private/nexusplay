{
  "name": "nexusplay",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:push": "pnpm --filter @nexusplay/db db:push",
    "db:migrate": "pnpm --filter @nexusplay/db db:migrate",
    "db:seed": "pnpm --filter @nexusplay/db db:seed",
    "db:studio": "pnpm --filter @nexusplay/db db:studio",
    "db:generate": "pnpm --filter @nexusplay/db db:generate",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0"
}
