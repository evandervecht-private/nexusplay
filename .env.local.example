# ─────────────────────────────────────────────────────────────────────────────
# NexusPlay - Local Development Environment
# Copy this file to .env.local — it works out of the box with Docker Compose.
# NEVER commit .env.local (it's gitignored)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Docker postgres service) ───────────────────────────────────────
DATABASE_URL="postgresql://nexusplay:dev@localhost:5432/nexusplay_dev"

# ── Redis (Docker redis service) ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="dev-jwt-secret-must-be-at-least-32-characters-long"
JWT_REFRESH_SECRET="dev-refresh-secret-must-be-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-nextauth-secret-must-be-at-least-32-chars"

# ── File Storage (Docker MinIO service, mirrors Cloudflare R2) ───────────────
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY="minioadmin"
R2_SECRET_KEY="minioadmin"
R2_BUCKET="nexusplay-assets"
R2_PUBLIC_URL="http://localhost:9000/nexusplay-assets"

# ── Email (Docker MailHog service) ───────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="noreply@nexusplay.local"
# View sent emails at: http://localhost:8025

# ── Payments (Sandbox / Test credentials) ────────────────────────────────────
PAYPAL_CLIENT_ID="sandbox-paypal-client-id"
PAYPAL_CLIENT_SECRET="sandbox-paypal-client-secret"
PAYPAL_MODE="sandbox"
MOLLIE_API_KEY="test_your_mollie_test_key_here"

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:2567"
NEXT_PUBLIC_R2_URL="http://localhost:9000/nexusplay-assets"
CORS_ORIGIN="http://localhost:3000"

# ── OAuth (optional for local dev — skip if not testing OAuth) ───────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── Feature Flags ─────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
