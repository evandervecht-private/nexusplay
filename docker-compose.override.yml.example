# Copy this to docker-compose.override.yml to customize your local setup.
# docker-compose.override.yml is gitignored — safe to put personal overrides here.
#
# Common use case: override ports if defaults conflict with existing services.

services:
  postgres:
    ports:
      - "5433:5432"   # Use 5433 if 5432 is taken

  redis:
    ports:
      - "6380:6379"   # Use 6380 if 6379 is taken

  # Disable a service you don't need locally:
  # web:
  #   profiles: ["disabled"]
